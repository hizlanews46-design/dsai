NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://nexus:nexus_secret@postgres:5432/nexus_comm?schema=public

# Redis
REDIS_URL=redis://redis:6379
REDIS_OTP_PREFIX=otp:
REDIS_OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=3
OTP_WINDOW_SECONDS=900

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=nexus-comm
JWT_AUDIENCE=nexus-mobile

# Cookies
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
REFRESH_COOKIE_NAME=nexus_rt

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Twilio SMS (leave TWILIO_ACCOUNT_SID empty to use custom REST SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Custom REST SMS gateway fallback
SMS_API_URL=
SMS_API_KEY=
SMS_API_FROM=

# OTP
OTP_LENGTH=6
OTP_DEV_ECHO=false

# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Account restoration (offline backup keys)
BACKUP_KEY_PEPPER=change-me-backup-pepper-min-32-chars
BACKUP_CHALLENGE_TTL_SECONDS=120

# Signaling
SIGNALING_PING_INTERVAL_MS=25000
SIGNALING_MAX_BUFFER_SIZE=1048576

# B2B SaaS (comma-separated key|name|tier|webhookUrl)
DSAIALAP_B2B_KEYS=
DSAIALAP_PUBLIC_HOST=dsaialap.banglarvoice24news.com
MASKED_ORIGINS=https://dsaialap.banglarvoice24news.com
